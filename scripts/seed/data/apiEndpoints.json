    "_id": "endpoint.northstar.wallet-balance",
    "_type": "apiEndpoint",
    "name": "Northstar Native Balance",
    "slug": { "_type": "slug", "current": "northstar-native-balance" },
    "product": { "_type": "reference", "_ref": "product.northstar-data" },
    "method": "GET",
    "path": "/v1/wallets/{address}/balance",
    "description": "Fetch native ETH/MATIC balance for a wallet address.",
    "authentication": ["api_key"],
    "parameters": [
      {
        "_type": "parameter",
        "name": "address",
        "type": "string",
        "required": true,
        "description": "0x-prefixed 40-character hex wallet address",
        "example": "0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045"
      },
      {
        "_type": "parameter",
        "name": "network",
        "type": "query",
        "required": false,
        "description": "Network parameter: 'ethereum' or 'polygon'. Default: 'ethereum'",
        "example": "ethereum"
      }
    ],
    "responseSchema": {
      "summary": "Balance response object with wei and formatted ether strings.",
      "fields": [
        { "_type": "responseField", "name": "address", "type": "string", "description": "Wallet address queried" },
        { "_type": "responseField", "name": "balanceWei", "type": "string", "description": "Balance in atomic wei units" },
        { "_type": "responseField", "name": "balanceEth", "type": "string", "description": "Decimal formatted balance" }
      ]
    },
    "capabilities": [
      { "_type": "reference", "_ref": "capability.wallet-balance" }
    ],
    "supportedNetworks": [
      { "_type": "reference", "_ref": "network.ethereum" },
      { "_type": "reference", "_ref": "network.polygon" }
    ],
    "rateLimit": {
      "_type": "rateLimit",
      "requests": 10,
      "window": "1s",
      "scope": "api_key",
      "description": "10 RPS throttle on free tier."
    },
    "limitations": [],
    "documentationUrl": "https://api-architect.internal/demo/docs/northstar/balance"
  },
