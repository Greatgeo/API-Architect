{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "studio:dev": "sanity dev",
    "studio:build": "sanity build studio/dist -y",
    "studio:validate": "sanity schemas validate",
    "studio:deploy": "sanity deploy",
    "schema:deploy": "sanity schema deploy",
    "seed:validate": "tsx scripts/seed/validate-seed.ts",
    "seed:export": "tsx scripts/seed/export-ndjson.ts",
    "dataset:import": "sanity dataset import scripts/seed/data/api-architect-dataset.ndjson production",
    "test:dataset": "tsx tests/dataset/verify-scenarios.ts",
    "test:agent": "tsx tests/agent/verify-agent-scenarios.ts",
    "test:mcp": "tsx tests/agent/verify-mcp-integration.ts",
    "dataset:check": "tsx scripts/seed/validate-seed.ts && tsx tests/dataset/verify-scenarios.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@sanity/vision": "^6.16.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sanity": "^6.16.0",
    "styled-components": "^6.5.3",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
