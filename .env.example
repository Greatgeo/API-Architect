# ==============================================================================
# API Architect — Environment Configuration
# ==============================================================================
# CRITICAL SECURITY NOTE:
# Secrets, tokens, and private API keys must remain strictly on the server-side.
# Never expose organization tokens, private MCP URLs, or model keys to the browser.
# Client-accessible environment variables must be explicitly prefixed (e.g. VITE_).
# ==============================================================================

# Application Runtime
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"

# Sanity Project Configuration (Server & Studio)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION="2026-03-01"

# Sanity Organization & Context MCP Configuration (Strictly Server-Side)
# Context MCP is created in the Sanity Dashboard Context app.
# Endpoint format: https://api.sanity.io/v1/context/organizations/<ORGANIZATION_ID>/mcp/<MCP_ENDPOINT_NAME>
SANITY_ORGANIZATION_ID=
SANITY_CONTEXT_MCP_URL=
# Organization-level API token with Context Viewer permission (project-level tokens are NOT substitutes)
SANITY_ORGANIZATION_TOKEN=

# Future Integration Placeholders (Phase 5 — AI Reasoning Layer)
# API key for the AI reasoning agent.
# In Google AI Studio runtime, GEMINI_API_KEY is injected automatically at runtime.
GEMINI_API_KEY=""
